  .hand--h { --a: var(--ah, 0deg); --dur: 43200s; stroke-width: 3.4; }
  .hand--m { --a: var(--am, 0deg); --dur: 3600s; stroke-width: 2.2; }
  .hand--s { --a: var(--as, 0deg); --dur: 60s; stroke: #b3122e; stroke-width: 1; }

