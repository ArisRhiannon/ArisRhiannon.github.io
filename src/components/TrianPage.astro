          <canvas class="mirror__gl" data-mirror-gl aria-hidden="true"></canvas>
            <svg class="clock" data-clock viewBox="-50 -50 100 100">
              <defs>
                <radialGradient id="trt-face">
                  <stop offset="0" stop-color="#fdfbf5" />
                  <stop offset=".8" stop-color="#ece6dc" />
                  <stop offset="1" stop-color="#bfb6b0" />
                </radialGradient>
              </defs>
              <circle r="48" fill="url(#trt-face)" stroke="#3a2f3d" stroke-width="3" />
              <circle r="40" fill="none" stroke="#3a2f3d" stroke-width=".8" />
              {Array.from({ length: 12 }, (_, k) => (
                <line y1="-44.5" y2={k % 3 ? '-41' : '-38.5'} transform={`rotate(${k * 30})`} stroke="#3a2f3d" stroke-width={k % 3 ? 1.2 : 2.4} />
              ))}
              <g class="clock__num" fill="#2b2230">
                <text y="-27">XII</text>
                <text x="29" y="1">III</text>
                <text y="29">VI</text>
                <text x="-29" y="1">IX</text>
              </g>
              <line class="hand hand--h" y1="5" y2="-21" />
              <line class="hand hand--m" y1="7" y2="-33" />
              <line class="hand hand--s" y1="10" y2="-37" />
              <circle r="2.8" fill="#1d1620" />
            </svg>
        </figure>
      </div>
    </section>

    <div class="sep" data-reveal aria-hidden="true"><span class="sep__band"></span><span class="sep__gem"><b>♦</b></span></div>

    <section class="arcs" aria-labelledby="trt-arcs">
      <header class="arcs__head">
        <p class="kicker">T · R · T</p>
        <h2 id="trt-arcs">{copy.deckTitle}</h2>
        <p>{copy.deckNote}</p>
      </header>

      <ul class="deck" role="list">
        {arcs.map((arc) => (
          <li class:list={['card', { 'card--red': arc.red }]} data-surface>
            <button class="card__flip" type="button" aria-pressed="false" aria-label={`${copy.flip}: ${arc.front}`}></button>
            <div class="card__tilt">
              <div class="card__inner">
                <article class="card__face card__front">
                  <span class="idx" aria-hidden="true">{arc.idx}<b>{arc.suit}</b></span>
                  <span class="pip" aria-hidden="true">{arc.suit}</span>
                  <div class="card__body">
                    <p class="card__author">{arc.by}</p>
                    <h3 class:list={['card__title', { 'card__title--long': arc.front.length > 14 }]}>{arc.front}</h3>
                    <p class="card__text">{arc.text}</p>
                  </div>
                  <span class="idx idx--br" aria-hidden="true">{arc.idx}<b>{arc.suit}</b></span>
                </article>
                <div class="card__face card__back" aria-hidden="true">
                  <span class="card__suit">{arc.suit}</span>
                  <span class="card__suit card__suit--br">{arc.suit}</span>
                  <svg class="medal" viewBox="-60 -60 120 120">
                    <circle class="medal__disc" r="57" />
                    <circle class="medal__ring" r="51.5" />
                    {Array.from({ length: 12 }, (_, k) => (
                      <line class="medal__tick" y1="-54.6" y2={k % 3 ? '-52.6' : '-50.4'} transform={`rotate(${k * 30})`} />
                    ))}
                    <svg x="-44" y="-31" width="88" height="58" viewBox="-6 5 380 250">
                      <use class="medal__t" href="#lg-t2" transform="translate(-399 0)" />
                      <use class="medal__r" href="#lg-r" transform="translate(-60 0)" />
                      <use class="medal__t" href="#lg-t2" transform="translate(-172 0)" />
                      <g transform="translate(257 12) rotate(-8 31 40) scale(1.3)"><use href="#trt-crown" /></g>
                    </svg>
                  </svg>
                  <span class="card__backname" lang={lang === 'ja' ? 'en' : 'ja'}>{arc.back}</span>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="sep sep--rev" data-reveal aria-hidden="true"><span class="sep__band"></span><span class="sep__gem"><b>♠</b></span></div>

    <div class="info">
      <section class="panel read" aria-labelledby="trt-read" data-surface>
        <h2 id="trt-read">{copy.readTitle}</h2>
        <figure>
          <img src="/trianthology/captura-es.webp" width="1024" height="576" loading="lazy" decoding="async" alt="" />
          <blockquote lang="es-419">
            <p>«Quizá la vida sea un viaje en busca de un trozo de sandía perdido en algún punto de un desierto de sal.»</p>
          </blockquote>
          <figcaption>
            — Alice · <span class="orig"><span>{copy.original}:</span> <span lang="ja">「多分、塩の砂漠のどこかに落ちてる、スイカのカケラを探す旅が人生だわ」</span></span>
          </figcaption>
        </figure>
      </section>

      <section class="panel install" aria-labelledby="trt-install" data-surface>
        <h2 id="trt-install">{copy.installTitle}</h2>
        <ol class="steps-trt">
          {copy.steps.map((s, i) => (
            <li><span class="roman" aria-hidden="true">{['I', 'II', 'III'][i]}</span><span set:html={s} /></li>
          ))}
        </ol>
        <a class="dl dl--small" href={DOWNLOAD} data-download>
          <span class="dl__label">{copy.download}</span>
          <span class="dl__meta">v{VERSION} · 43 MB</span>
        </a>
      </section>

      <section class="panel faq" aria-labelledby="trt-faq" data-surface>
        <h2 id="trt-faq">{copy.faqTitle}</h2>
        {copy.faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p set:html={a} />
          </details>
        ))}
      </section>
    </div>

    <footer class="credits">
      <p><strong>{copy.credits[0]}</strong> Aris Rhiannon (<a href="https://x.com/goddamnBern">@goddamnBern</a>)</p>
      <p><strong>{copy.credits[1]}</strong> <a href="https://x.com/nitronnix">NitroNNIx</a></p>
      <p>
        <strong>{copy.credits[2]}</strong>
        <a href={`${REPO}/blob/main/LICENSE.translation`}>{copy.credits[3]}: CC BY-NC-SA 4.0</a> ·
        <a href={`${REPO}/blob/main/LICENSE`}>{copy.credits[4]}: AGPL-3.0-or-later</a>
      </p>
      <p class="credits__note">{copy.unofficial}</p>
      <p><strong>{copy.music}</strong> TRianThology OST · 07th Expansion</p>
      <span class="suits" aria-hidden="true">♠<b>♥</b>♣<b>♦</b></span>
    </footer>

    <button class="bgm" type="button" aria-pressed="false" data-bgm title={copy.bgm}>
      <span class="sr-only">{copy.bgm}</span>
      <svg class="bgm__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 17.5V6.2l10-2.2v11.5" />
        <circle cx="6.6" cy="17.6" r="2.4" />
        <circle cx="16.6" cy="15.5" r="2.4" />
        <path class="bgm__slash" d="M4.5 4.5l15 15" />
      </svg>
      <span class="bgm__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </button>
    <audio data-bgm-audio loop preload="none">
      <source src="/trianthology/bgm.webm" type="audio/webm; codecs=opus" />
      <source src="/trianthology/bgm.m4a" type="audio/mp4" />
    </audio>
  </div>
</SiteLayout>

<script>
  document.documentElement.classList.add('trt-js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const numberFormat = new Intl.NumberFormat(document.documentElement.lang);

  /* Clock: real local time; CSS spins the hands from these start angles. */
  const clock = document.querySelector<SVGSVGElement>('[data-clock]');
  if (clock) {
    const now = new Date();
    const s = now.getSeconds() + now.getMilliseconds() / 1000;
    const m = now.getMinutes() + s / 60;
    const h = (now.getHours() % 12) + m / 60;
    clock.style.setProperty('--ah', `${h * 30}deg`);
    clock.style.setProperty('--am', `${m * 6}deg`);
    clock.style.setProperty('--as', `${s * 6}deg`);
  }

  /* Counters */
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const io = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = numberFormat.format(Math.round(end * (1 - (1 - p) ** 3)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
      io.observe(el);
    });
  }

  /* Mirror: the still paints first; the living WebGL mirror (trt-rig.ts) takes over once its
     layers are in. Reduced motion, no WebGL or a slow network keep the still. */
  const figure = document.querySelector<HTMLElement>('[data-mirror]');
  const glCanvas = document.querySelector<HTMLCanvasElement>('[data-mirror-gl]');
  let rig: { pointer(nx: number, ny: number): void } | undefined;
  const still = () => figure?.classList.add('is-still', 'is-ready');
  if (figure && glCanvas && !reduce) {
    const slow = setTimeout(still, 3500);
    import('./trt-rig')
      .then(({ startMirror }) =>
        startMirror(glCanvas, {
          skipOpen: () => figure.classList.contains('is-still'),
          onShow: () => {
            clearTimeout(slow);
            figure.classList.add('is-gl', 'is-ready');
          },
          onLost: () => {
            figure.classList.remove('is-gl');
            still();
          },
        })
      )
      .then((r) => (rig = r))
      .catch(() => {
        clearTimeout(slow);
        still();
      });
  } else {
    still();
  }

  /* Pointer: Alice's parallax, and the rain umbrella. */

  const pointer = { x: -1e4, y: -1e4, on: false };
  const mirror = document.querySelector<HTMLElement>('[data-mirror]');
  let mirrorQueued = false;
  const updateMirror = () => {
    mirrorQueued = false;
    if (!mirror) return;
    const r = mirror.getBoundingClientRect();
    const nx = Math.max(0, Math.min(1, (pointer.x - r.left) / r.width));
    const ny = Math.max(0, Math.min(1, (pointer.y - r.top) / r.height));
    rig?.pointer((nx - 0.5) * 2, (ny - 0.5) * 2);
  };
  if (fine && !reduce) {
    addEventListener(
      'pointermove',
      (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;
        pointer.on = true;
        if (!mirrorQueued) {
          mirrorQueued = true;
          requestAnimationFrame(updateMirror);
        }
      },
      { passive: true }
    );
    document.documentElement.addEventListener('pointerleave', () => (pointer.on = false));
  }

  /* Cards: flip + holographic foil */
  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    const button = card.querySelector('button');
    button?.addEventListener('click', () =>
      button.setAttribute('aria-pressed', String(button.getAttribute('aria-pressed') !== 'true'))
    );
    if (!fine || reduce) return;
    /* Lift and tilt follow the pointer through a critically damped spring, so the card eases
       back to its place on leave. The hit area (the <li>) never moves, so edges don't flicker. */
    const now = { tx: 0, ty: 0, lift: 0 };
    const goal = { tx: 0, ty: 0, lift: 0 };
    let raf = 0;
    let last = 0;
    const step = (t: number) => {
      const k = 1 - Math.exp(-Math.min(0.05, (t - last) / 1000) * 14);
      last = t;
      let moving = false;
      for (const key of ['tx', 'ty', 'lift'] as const) {
        now[key] += (goal[key] - now[key]) * k;
        if (Math.abs(goal[key] - now[key]) > 0.001) moving = true;
        else now[key] = goal[key];
      }
      card.style.setProperty('--tx', now.tx.toFixed(4));
      card.style.setProperty('--ty', now.ty.toFixed(4));
      card.style.setProperty('--lift', now.lift.toFixed(4));
      raf = moving ? requestAnimationFrame(step) : 0;
    };
    const kick = () => {
      if (raf) return;
      last = performance.now();
      raf = requestAnimationFrame(step);
    };
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
      const y = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));
      card.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
      card.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
      goal.tx = x - 0.5;
      goal.ty = y - 0.5;
      goal.lift = 1;
      kick();
    });
    card.addEventListener('pointerleave', () => {
      goal.tx = goal.ty = goal.lift = 0;
      kick();
    });
    /* Keyboard focus lifts too; a mouse click must not leave the card stuck up. */
    button?.addEventListener('focus', () => {
      if (button.matches(':focus-visible')) (goal.lift = 1), kick();
    });
    button?.addEventListener('blur', () => {
      if (!card.matches(':hover')) (goal.lift = 0), kick();
    });
  });

  /* Separators play their entrance once they scroll into view. */
  const reveal = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        reveal.unobserve(e.target);
      }),
    { threshold: 0.6 }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

  /* Background music: off until asked, choice remembered. A WebAudio gain gives smooth,
     quiet fades everywhere (iOS ignores media.volume). The file is mastered at -23 LUFS. */
  const bgmButton = document.querySelector<HTMLButtonElement>('[data-bgm]');
  const audio = document.querySelector<HTMLAudioElement>('[data-bgm-audio]');
  if (bgmButton && audio) {
    const LEVEL = 0.55;
    let ctx: AudioContext | undefined;
    let gain: GainNode | undefined;
    let on = false;
    let pauseTimer = 0;
    const fade = (to: number, secs: number) => {
      if (!ctx || !gain) return;
      const t = ctx.currentTime;
      gain.gain.cancelScheduledValues(t);
      gain.gain.setValueAtTime(gain.gain.value, t);
      gain.gain.linearRampToValueAtTime(to, t + secs);
    };
    const start = async () => {
      clearTimeout(pauseTimer);
      if (!ctx) {
        ctx = new AudioContext();
        gain = ctx.createGain();
        gain.gain.value = 0;
        ctx.createMediaElementSource(audio).connect(gain).connect(ctx.destination);
      }
      await ctx.resume();
      await audio.play();
      fade(LEVEL, 3);
    };
    const stop = () => {
      fade(0, 0.6);
      clearTimeout(pauseTimer);
      pauseTimer = window.setTimeout(() => audio.pause(), 650);
    };
    const remember = (value: string) => {
      try {
        localStorage.setItem('trt-bgm', value);
      } catch {
        /* private mode: just don't remember */
      }
    };
    const set = (next: boolean) => {
      on = next;
      bgmButton.setAttribute('aria-pressed', String(on));
      remember(on ? '1' : '0');
      if (on) start().catch(() => set(false));
      else stop();
    };
    bgmButton.addEventListener('click', () => set(!on));
    document.addEventListener('visibilitychange', () => {
      if (!on) return;
      if (document.hidden) stop();
      else start().catch(() => {});
    });
    let wanted = false;
    try {
      wanted = localStorage.getItem('trt-bgm') === '1';
    } catch {
      /* ignore */
    }
    if (wanted) {
      // Autoplay with sound is blocked, so resume on the first gesture anywhere on the page.
      const gesture = new AbortController();
      const resume = (e: Event) => {
        gesture.abort();
        if (!(e.target instanceof Node && bgmButton.contains(e.target))) set(true);
      };
      addEventListener('pointerdown', resume, { capture: true, signal: gesture.signal });
      addEventListener('keydown', resume, { capture: true, signal: gesture.signal });
    }
  }

  /* Theatrical confetti: suits and bows, on a throwaway canvas. */
  const burst = (x0: number, y0: number) => {
    const c = document.createElement('canvas');
    c.setAttribute('aria-hidden', 'true');
    c.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:9999';
    document.body.append(c);
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const w = innerWidth;
    const h = innerHeight;
    c.width = w * dpr;
    c.height = h * dpr;
    const g = c.getContext('2d');
    if (!g) return c.remove();
    g.scale(dpr, dpr);
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    const SUITS = ['♠', '♥', '♣', '♦'];
    const COLORS = ['#d4213d', '#f4efe7', '#e3c88a', '#140e17'];
    const parts = Array.from({ length: 96 }, (_, i) => {
      const a = -Math.PI / 2 + (Math.random() - 0.5) * 2.1;
      const v = 7 + Math.random() * 10;
      const suit = SUITS[(Math.random() * 4) | 0];
      const bow = i % 3 === 0;
      return {
        x: x0, y: y0,
        vx: Math.cos(a) * v, vy: Math.sin(a) * v,
        r: Math.random() * 6.28, vr: (Math.random() - 0.5) * 0.3,
        s: 10 + Math.random() * 12, t: Math.random() * 6.28,
        k: bow ? '' : suit,
        c: bow ? COLORS[i % 4] : suit === '♥' || suit === '♦' ? '#d4213d' : COLORS[1 + (i % 2) * 2],
      };
    });
    let last = performance.now();
    const end = last + 2800;
    const frame = (now: number) => {
      const f = Math.min(2.5, (now - last) / 16.67);
      last = now;
      g.clearRect(0, 0, w, h);
      g.globalAlpha = Math.max(0, Math.min(1, (end - now) / 700));
      for (const p of parts) {
        p.vx *= 0.986 ** f;
        p.vy = p.vy * 0.986 ** f + 0.3 * f;
        p.x += p.vx * f;
        p.y += p.vy * f;
        p.r += p.vr * f;
        p.t += 0.18 * f;
        g.save();
        g.translate(p.x, p.y);
        g.rotate(p.r);
        g.scale(1, Math.cos(p.t));
        g.fillStyle = p.c;
        if (p.k) {
          g.font = `${p.s}px Georgia, serif`;
          if (p.c === '#140e17') {
            g.strokeStyle = '#f4efe7';
            g.lineWidth = 1;
            g.strokeText(p.k, 0, 0);
          }
          g.fillText(p.k, 0, 0);
        } else {
          const s = p.s * 0.55;
          g.beginPath();
          g.moveTo(0, 0); g.lineTo(-s, -s * 0.6); g.lineTo(-s, s * 0.6);
          g.moveTo(0, 0); g.lineTo(s, -s * 0.6); g.lineTo(s, s * 0.6);
          g.fill();
          g.fillRect(-s * 0.18, -s * 0.22, s * 0.36, s * 0.44);
        }
        g.restore();
      }
      if (now < end) requestAnimationFrame(frame);
      else c.remove();
    };
    requestAnimationFrame(frame);
  };
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-download]').forEach((a) =>
      a.addEventListener('click', () => {
        const r = a.getBoundingClientRect();
        burst(r.left + r.width / 2, r.top + r.height / 2);
      })
    );
  }

  /* Rain: 3 depth layers (one stroke each). Near layers splash on [data-surface]
     top edges, on the viewport floor and on an invisible umbrella around the cursor. */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-rain]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx && !reduce) {
    const WIND = 0.17;
    const UMBRELLA = 74;
    const LAYERS = [
      { len: 8, speed: 380, width: 0.55, alpha: 0.14, hits: false, share: 0.46 },
      { len: 14, speed: 620, width: 0.85, alpha: 0.24, hits: true, share: 0.34 },
      { len: 23, speed: 900, width: 1.25, alpha: 0.34, hits: true, share: 0.2 },
    ];
    let W = 0;
    let H = 0;
    let left = 0;
    let drops: Float32Array[] = [];
    let surfaces: { l: number; r: number; t: number; h: number; p?: number[] }[] = [];
    const bits: { x: number; y: number; vx: number; vy: number; life: number }[] = [];
    const rings: { x: number; y: number; age: number; w: number }[] = [];

    const spawnX = () => Math.random() * (W + H * WIND) - H * WIND;

    /* Boxes splash on their top edge; the mirror splashes on its real silhouette (data-top). */
    const measure = () => {
      surfaces = Array.from(document.querySelectorAll<HTMLElement>('[data-surface], [data-top]'), (el) => {
        const r = el.getBoundingClientRect();
        const p = el.dataset.top?.split(' ').map(Number);
        return { l: r.left - left, r: r.right - left, t: r.top + scrollY, h: r.height, p };
      });
    };

    const resize = () => {
      const box = canvas.getBoundingClientRect();
      left = box.left;
      W = box.width;
      H = box.height;
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.max(1, Math.round(W * dpr));
      canvas.height = Math.max(1, Math.round(H * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const total = Math.round(Math.min(380, (W * H) / 3400));
      drops = LAYERS.map((layer) => {
        const a = new Float32Array(Math.round(total * layer.share) * 2);
        for (let i = 0; i < a.length; i += 2) {
          a[i] = spawnX();
          a[i + 1] = Math.random() * H;
        }
        return a;
      });
      measure();
    };

    const splash = (x: number, y: number, size: number, nx = 0, ny = -1, ring = true) => {
      if (ring && rings.length < 70) rings.push({ x, y, age: 0, w: size });
      for (let k = 0; k < 3 && bits.length < 260; k++) {
        const spread = (Math.random() - 0.5) * 150 * size;
        const up = (70 + Math.random() * 110) * Math.sqrt(size);
        bits.push({ x, y: y - 1, vx: nx * up + spread * -ny, vy: ny * up + spread * nx * 0.5, life: 0.28 + Math.random() * 0.2 });
      }
    };

    let last = performance.now();
    let raf = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      ctx.clearRect(0, 0, W, H);
      ctx.lineCap = 'round';

      const sy = scrollY;
      const visible = surfaces
        .map((s) => ({ ...s, t: s.t - sy }))
        .filter((s) => s.t + (s.p ? s.h : 0) > 0 && s.t < H);
      const cx = pointer.x - left;
      const cy = pointer.y;
      const R2 = UMBRELLA * UMBRELLA;

      LAYERS.forEach((layer, li) => {
        const a = drops[li];
        const dy = layer.speed * dt;
        const dx = dy * WIND;
        ctx.beginPath();
        for (let i = 0; i < a.length; i += 2) {
          const y0 = a[i + 1];
          const x = a[i] + dx;
          const y = y0 + dy;
          let hit = false;
          if (layer.hits) {
            for (const s of visible) {
              if (x < s.l || x > s.r) continue;
              const top = s.p ? s.t + s.p[Math.min(s.p.length - 1, (((x - s.l) / (s.r - s.l)) * s.p.length) | 0)] * s.h : s.t;
              if (y0 < top && y >= top) {
                splash(x, top, layer.width);
                hit = true;
                break;
              }
            }
            if (!hit && pointer.on) {
              const ox = x - cx;
              const oy = y - cy;
              const d2 = ox * ox + oy * oy;
              if (oy < 0 && d2 < R2) {
                const d = Math.sqrt(d2) || 1;
                splash(cx + (ox / d) * UMBRELLA, cy + (oy / d) * UMBRELLA, layer.width, ox / d, oy / d, false);
                hit = true;
              }
            }
          }
          if (!hit && y >= H) {
            if (layer.hits || i % 6 === 0) splash(x, H - 1, layer.width);
            hit = true;
          }
          if (hit) {
            a[i] = spawnX();
            a[i + 1] = -layer.len - Math.random() * H * 0.25;
            continue;
          }
          a[i] = x;
          a[i + 1] = y;
          ctx.moveTo(x - WIND * layer.len, y - layer.len);
          ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `rgba(196, 220, 244, ${layer.alpha})`;
        ctx.lineWidth = layer.width;
        ctx.stroke();
      });

      ctx.lineWidth = 0.7;
      for (let i = rings.length - 1; i >= 0; i--) {
        const ring = rings[i];
        ring.age += dt;
        const p = ring.age / 0.36;
        if (p >= 1) {
          rings.splice(i, 1);
          continue;
        }
        ctx.strokeStyle = `rgba(206, 228, 250, ${(1 - p) * 0.42})`;
        ctx.beginPath();
        ctx.ellipse(ring.x, ring.y, ring.w * (1.5 + p * 6), 0.6 + p * 1.4, 0, Math.PI, Math.PI * 2);
        ctx.stroke();
      }

      ctx.beginPath();
      for (let i = bits.length - 1; i >= 0; i--) {
        const b = bits[i];
        b.life -= dt;
        if (b.life <= 0) {
          bits.splice(i, 1);
          continue;
        }
        b.vy += 900 * dt;
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        ctx.moveTo(b.x, b.y);
        ctx.lineTo(b.x - b.vx * 0.012, b.y - b.vy * 0.012);
      }
      ctx.strokeStyle = 'rgba(214, 233, 252, 0.5)';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      raf = requestAnimationFrame(frame);
    };

    const setActive = () => {
      cancelAnimationFrame(raf);
      if (document.visibilityState === 'visible') {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    };

    resize();
    addEventListener('resize', resize, { passive: true });
    new ResizeObserver(() => measure()).observe(document.body);
    setTimeout(measure, 3000); // after the mirror wings finish opening
    document.fonts?.ready.then(measure);
    document.addEventListener('visibilitychange', setActive);
    setActive();
  }
</script>

