  /* ---------- Deck ---------- */
  .arcs {
    display: grid;
    grid-template-columns: minmax(12rem, 17rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
  }

  .arcs__head h2 {
    font-size: clamp(1.7rem, 2.6vw, 2.4rem);
  }

  .arcs__head p:last-child {
    margin: 0.5rem 0 0;
