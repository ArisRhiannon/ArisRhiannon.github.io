    font-size: 0.88rem;
  }

  .deck {
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 1.2rem 0 1.8rem;
    list-style: none;
  }

  .card {
    --r: 0deg;
    --y: 0;
    --mx: 50%;
    --my: 50%;
    position: relative;
    flex: 0 0 clamp(10rem, 12.4vw, 12rem);
    aspect-ratio: 5 / 7;
    margin-inline: 0.05rem;
    --lift: 0;
    perspective: 900px;
    transform: translateY(var(--y)) rotate(var(--r));
  }

  .card:nth-child(1) { --r: -7deg; --y: 0.9rem; }
  .card:nth-child(2) { --r: -2.3deg; --y: 0.1rem; }
  .card:nth-child(3) { --r: 2.3deg; --y: 0.1rem; }
  .card:nth-child(4) { --r: 7deg; --y: 0.9rem; }

  /* The <li> stays put (stable hit area); only the drawn card lifts. JS springs --lift/--tx/--ty. */
  .card:hover,
  .card:has(.card__flip:focus-visible) {
    z-index: 3;
  }

  .card:has(.card__flip:focus-visible) {
    --lift: 1;
  }

  .card__flip {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    border-radius: 0.8rem;
    background: none;
    cursor: pointer;
  }

  .card__tilt,
  .card__inner {
    height: 100%;
    transform-style: preserve-3d;
  }

  .card__tilt {
    transform:
