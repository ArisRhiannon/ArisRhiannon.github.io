---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  status: 'Completado' | 'En desarrollo' | 'Planificado';
  link?: string;
}

const { title, subtitle, description, status, link } = Astro.props;

const statusColors = {
  'Completado': 'border-emerald-600/20 text-emerald-700 bg-emerald-50',
  'En desarrollo': 'border-amber-600/30 text-amber-800 bg-amber-50',
  'Planificado': 'border-slate-300 text-slate-500 bg-slate-50'
}[status];
---

<div class="border border-[#e6dec9] border-t-2 border-t-[#b58b4c] bg-gradient-to-br from-[#fdfcf7]/80 to-[#fcfaf2]/60 p-6 rounded-md hover:border-[#b58b4c] hover:border-t-[#b58b4c] transition-all duration-300 relative group flex flex-col justify-between min-h-[190px] shadow-sm hover:shadow-[0_8px_30px_rgba(181,139,76,0.06)]">
  <div class="space-y-3">
    <div class="flex justify-between items-start gap-4">
      <div>
        <h4 class="font-display text-base sm:text-lg text-[#2c241e] tracking-wide group-hover:text-[#b58b4c] transition-colors">
          {title}
        </h4>
        <span class="font-mono text-[9px] text-[#7c6e62] uppercase tracking-widest block mt-0.5">
          {subtitle}
        </span>
      </div>
      <span class={`font-mono text-[8px] sm:text-[9px] uppercase tracking-wider px-2 py-0.5 border rounded-sm ${statusColors}`}>
        {status}
      </span>
    </div>
    <p class="font-serif text-sm text-[#4a3e37] leading-relaxed">
      {description}
    </p>
  </div>
  
  {link && (
    <div class="pt-4 mt-auto">
      <a 
        href={link} 
        class="inline-flex items-center gap-1.5 font-mono text-[10px] text-[#8b5a2b] hover:text-[#b58b4c] border-b border-dashed border-[#8b5a2b]/40 hover:border-[#b58b4c] transition-all"
      >
        <span>Detalles del proyecto</span>
        <span class="text-xs">→</span>
      </a>
    </div>
  )}
</div>
