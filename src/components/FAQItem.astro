---
interface Props {
  question: string;
  answer: string;
  id: string;
}

const { question, answer, id } = Astro.props;
---

<div class="border border-[#e6dec9] bg-[#fdfcf7]/60 rounded-md overflow-hidden transition-all duration-300 hover:border-[#b58b4c] shadow-sm">
  <button
    class="w-full text-left p-4 font-serif text-sm sm:text-base text-[#2c241e] hover:text-[#b58b4c] flex justify-between items-center transition-colors focus:outline-none"
    aria-expanded="false"
    aria-controls={`faq-answer-${id}`}
    id={`faq-btn-${id}`}
    data-faq-btn
  >
    <span class="tracking-wide font-medium">{question}</span>
    <svg
      class="w-4 h-4 text-[#b58b4c] transform transition-transform duration-300"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  <div
    id={`faq-answer-${id}`}
    class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out"
    aria-labelledby={`faq-btn-${id}`}
    role="region"
  >
    <div class="p-4 pt-0 text-sm text-[#4a3e37] border-t border-[#e6dec9]/60 leading-relaxed font-serif">
      {answer}
    </div>
  </div>
</div>

<script>
  const buttons = document.querySelectorAll('[data-faq-btn]');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', (!expanded).toString());
      
      const svg = button.querySelector('svg');
      if (svg) {
        if (!expanded) {
          svg.classList.add('rotate-180');
        } else {
          svg.classList.remove('rotate-180');
        }
      }
      
      const answerId = button.getAttribute('aria-controls');
      if (answerId) {
        const answer = document.getElementById(answerId);
        if (answer) {
          if (!expanded) {
            answer.style.maxHeight = answer.scrollHeight + 'px';
          } else {
            answer.style.maxHeight = '0px';
          }
        }
      }
    });
  });
</script>
