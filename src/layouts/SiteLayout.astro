---
interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  theme?: 'paper' | 'night';
}

const {
  title,
  description,
  canonical,
  image,
  theme = 'paper',
} = Astro.props;

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Inicio', short: 'Inicio' },
  { href: '/#proyectos', label: 'Proyectos', short: 'Proy.' },
  { href: '/#archivo', label: 'Archivo', short: 'Archivo' },
  { href: '/trianthology/', label: 'TrianThology', short: 'Trian' },
  { href: '/ciconia/', label: 'Ciconia', short: 'Ciconia' },
];
---

<!doctype html>
<html lang="es-419" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#120f17" />
    <meta name="google-site-verification" content="imK_jF_dOkcg7xB4k7Hx6BiKjvD_U-UTXiyOxYW_2Uk" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aris Rhiannon" />
    <meta property="og:locale" content="es_419" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Aris Rhiannon, inicio">
          <span class="brand__portrait">
            <img
              class="brand__avatar"
              src="/favicon.png"
              width="80"
              height="80"
              alt=""
            />
          </span>
          <span class="brand__copy">
            <span class="brand__name">Aris Rhiannon</span>
            <span class="brand__descriptor">Traducciones · es-419</span>
          </span>
        </a>

        <nav aria-label="Navegación principal">
          <ul class="site-nav">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-label={item.label}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                >
                  <span class="nav-label">{item.label}</span>
                  <span class="nav-label nav-label--short" aria-hidden="true">{item.short}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav class="sidebar-contact" aria-label="Contacto">
          <a href="https://github.com/ArisRhiannon">GitHub</a>
          <a href="https://x.com/goddamnBern">X</a>
          <a href="https://www.youtube.com/@GoddamnBernkastel">YouTube</a>
          <a href="https://discord.com/users/aris_rhiannon">Discord</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-footer__legal">
          © 2026 Aris Rhiannon. Los títulos y marcas citados pertenecen a sus respectivos propietarios.
        </p>
      </div>
    </footer>

    <script>
      const sectionLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="/#"]')
      );

      if (location.pathname === '/' && sectionLinks.length) {
        const homeLink = document.querySelector<HTMLAnchorElement>('.site-nav a[href="/"]');
        const sections = sectionLinks
          .map((link) => ({ link, section: document.querySelector<HTMLElement>(link.hash) }))
          .filter(
            (entry): entry is { link: HTMLAnchorElement; section: HTMLElement } =>
              Boolean(entry.section)
          );

        const updateCurrentSection = () => {
          const marker = scrollY + innerHeight * 0.35;
          const fitsViewport = document.documentElement.scrollHeight <= innerHeight + 8;
          const atBottom = scrollY + innerHeight >= document.documentElement.scrollHeight - 8;
          const hashLink = sectionLinks.find((link) => link.hash === location.hash);
          const current =
            fitsViewport
              ? hashLink ?? homeLink
              : atBottom
              ? sections[sections.length - 1]?.link
              : scrollY < 64
              ? homeLink
              : [...sections].reverse().find(({ section }) => section.offsetTop <= marker)?.link;

          [homeLink, ...sectionLinks].forEach((link) => {
            if (!link) return;
            if (link === current) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        };

        addEventListener('scroll', updateCurrentSection, { passive: true });
        addEventListener('resize', updateCurrentSection);
        addEventListener('hashchange', updateCurrentSection);
        updateCurrentSection();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --paper: oklch(12.5% 0.018 315);
    --surface: oklch(16% 0.022 315);
    --surface-strong: oklch(19% 0.025 315);
    --ink: oklch(94% 0.012 315);
    --muted: oklch(74% 0.025 315);
    --faint: oklch(60% 0.03 315);
    --line: oklch(30% 0.03 315);
    --line-strong: oklch(43% 0.045 315);
    --accent: oklch(68% 0.14 326);
    --accent-strong: oklch(79% 0.11 326);
    --accent-soft: oklch(26% 0.07 326);
    --positive: oklch(72% 0.11 155);
    --warning: oklch(74% 0.12 86);
    --gold: oklch(77% 0.1 86);
    --header: oklch(9.5% 0.015 315);
    --header-ink: oklch(94% 0.012 315);
    --header-muted: oklch(68% 0.025 315);
    --focus: #f3cf4f;
    --focus-ink: #141414;
    --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
    --sans: Aptos, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --mono: "Cascadia Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --measure: 70ch;
    --page: 1380px;
    --sidebar: 224px;
    --radius: 2px;
  }

  [data-theme="night"] {
    color-scheme: dark;
    --paper: oklch(12.5% 0.018 315);
    --surface: oklch(16% 0.022 315);
    --surface-strong: oklch(19% 0.025 315);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 1rem;
    overflow-x: clip;
    background: var(--paper);
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--ink);
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--accent);
  }

  :where(a, button, summary):focus-visible {
    outline: 3px solid var(--focus-ink);
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--focus);
    border-radius: 1px;
  }

  button,
  summary {
    font: inherit;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.08;
    text-wrap: balance;
  }

  p,
  ul,
  ol,
  dl,
  figure {
    margin-top: 0;
  }

  code {
    padding: 0.12rem 0.3rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 0.88em;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    min-height: 44px;
    padding: 0.65rem 1rem;
    transform: translateY(-160%);
    background: var(--focus);
    color: var(--focus-ink);
    font-weight: 700;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 40;
    width: var(--sidebar);
    border-right: 1px solid var(--line);
    background: var(--header);
    color: var(--header-ink);
    view-transition-name: site-sidebar;
  }

  .site-header__inner {
    width: 100%;
    height: 100%;
    padding: 1.6rem 1.25rem 1.25rem;
    display: flex;
    align-items: stretch;
    flex-direction: column;
    gap: 1.4rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    color: var(--header-ink);
    text-decoration: none;
  }

  .brand__portrait {
    display: block;
    border-radius: 50%;
    animation: portrait-halo 7s ease-in-out infinite;
  }

  .brand__avatar {
    width: 80px;
    height: 80px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    object-fit: cover;
    outline: 5px solid color-mix(in oklch, var(--accent) 16%, transparent);
  }

  .brand__copy {
    display: flex;
    flex-direction: column;
  }

  .brand__name {
    font-family: var(--serif);
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: 0.035em;
  }

  .brand__descriptor {
    color: var(--header-muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav,
  .footer-links {
    display: flex;
    align-items: stretch;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .site-nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius);
    color: var(--header-muted);
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current] {
    color: var(--header-ink);
    background: var(--accent-soft);
  }

  .site-nav a[aria-current]::after {
    position: absolute;
    right: 0.65rem;
    width: 0.38rem;
    height: 0.38rem;
    margin-left: auto;
    rotate: 45deg;
    background: var(--gold);
    content: "";
  }

  .nav-label--short {
    display: none;
  }

  .sidebar-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.65rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .sidebar-contact a {
    color: var(--header-muted);
    font-family: var(--mono);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sidebar-contact a:hover {
    color: var(--accent-strong);
  }

  .site-footer {
    margin-left: var(--sidebar);
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .site-footer__inner {
    width: min(calc(100% - 3rem), var(--page));
    margin-inline: auto;
    padding-block: 1rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .site-footer p {
    margin-bottom: 0;
  }

  .site-footer__legal {
    font-size: inherit;
  }

  main {
    min-height: calc(100vh - 3rem);
    margin-left: var(--sidebar);
  }

  .page {
    width: min(calc(100% - 3rem), var(--page));
    margin-inline: auto;
  }

  .hero {
    padding-block: clamp(1.8rem, 3vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(17rem, 4fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero-grid > * {
    min-width: 0;
  }

  .eyebrow {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--gold);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 20ch;
    font-size: clamp(2.35rem, 4vw, 4rem);
    letter-spacing: -0.025em;
  }

  .hero-lede {
    max-width: 52ch;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.4vw, 1.12rem);
    line-height: 1.5;
  }

  .hero-actions,
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .hero-actions .button {
    flex: 0 1 auto;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-strong);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .button--primary {
    border-color: var(--accent);
    background: var(--accent);
    color: #140f16;
  }

  .button--primary:hover {
    border-color: var(--accent-strong);
    background: var(--accent-strong);
    color: #140f16;
  }

  .brief {
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 1rem 2.5rem oklch(4% 0.02 315 / 0.18);
  }

  .brief dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem 1rem;
    margin: 0;
  }

  .brief dt {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .brief dd {
    margin: 0;
    color: var(--ink);
    font-weight: 650;
  }

  .section {
    padding-block: clamp(2rem, 3.5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .section-heading--compact {
    grid-template-columns: 1fr;
  }

  .section-heading h2 {
    font-size: clamp(1.65rem, 2.5vw, 2.35rem);
    letter-spacing: -0.02em;
  }

  .section-heading p {
    max-width: 58ch;
    margin-bottom: 0;
    color: var(--muted);
  }

  .project-grid,
  .feature-grid,
  .story-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card,
  .feature,
  .story-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(1rem, 2vw, 1.35rem);
    box-shadow: 0 1rem 2.5rem oklch(4% 0.02 315 / 0.14);
  }

  .project-card--featured {
    border-color: var(--line-strong);
  }

  .project-card h3,
  .story-card h3 {
    margin-top: 0.55rem;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }

  .project-card p,
  .feature p,
  .story-card p {
    color: var(--muted);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .status::before {
    width: 0.65rem;
    height: 0.65rem;
    background: var(--line-strong);
    content: "";
  }

  .status--available::before {
    background: var(--positive);
  }

  .status--progress::before {
    background: var(--warning);
  }

  .archive-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .archive-list li {
    border-bottom: 1px solid var(--line);
  }

  .archive-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 52px;
    padding-block: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .archive-list a:hover .archive-list__title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .archive-list__meta {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-align: right;
  }

  .prose {
    max-width: var(--measure);
  }

  .prose > * + * {
    margin-top: 1.15rem;
  }

  .prose h2 {
    margin-top: 2.5rem;
    font-size: clamp(1.75rem, 3.5vw, 2.6rem);
  }

  .prose h3 {
    margin-top: 2rem;
    font-size: 1.35rem;
  }

  .prose p,
  .prose li {
    color: var(--muted);
  }

  .prose strong {
    color: var(--ink);
  }

  .notice {
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface-strong);
    padding: 1.25rem 1.5rem;
  }

  .notice > :last-child {
    margin-bottom: 0;
  }

  .media-frame {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 0.5rem;
  }

  .steps {
    padding-left: 1.4rem;
  }

  .steps li {
    padding: 0.4rem 0 0.8rem 0.45rem;
  }

  details {
    border-top: 1px solid var(--line);
  }

  details:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    min-height: 56px;
    padding: 0.9rem 2.5rem 0.9rem 0;
    cursor: pointer;
    color: var(--ink);
    font-weight: 700;
  }

  details > div {
    max-width: var(--measure);
    padding: 0 0 1.25rem;
    color: var(--muted);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  th,
  td {
    padding: 0.8rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--line-strong);
  }

  @view-transition {
    navigation: auto;
  }

  ::view-transition-group(root) {
    animation-duration: 180ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  ::view-transition-group(site-sidebar) {
    animation-duration: 120ms;
  }

  @keyframes portrait-halo {
    0%,
    100% {
      box-shadow:
        0 0 0 0 oklch(68% 0.14 326 / 0.04),
        0 0 1rem oklch(68% 0.14 326 / 0.07);
    }

    50% {
      box-shadow:
        0 0 0 0.22rem oklch(68% 0.14 326 / 0.09),
        0 0 1.6rem oklch(77% 0.1 86 / 0.11);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card,
    .story-card {
      transition:
        transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
        border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
        background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .project-card:hover,
    .story-card:hover {
      border-color: color-mix(in oklch, var(--accent) 48%, var(--line));
      background: color-mix(in oklch, var(--surface) 92%, var(--accent));
      transform: translateY(-2px);
    }

    .archive-list a:hover {
      background: color-mix(in oklch, var(--surface) 88%, var(--accent));
    }
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(19rem, 5fr);
    gap: 1rem;
    align-items: start;
    padding-block: 1rem 1.5rem;
  }

  .home-grid .section {
    padding: 1.15rem;
    border: 1px solid var(--line);
    background: var(--surface-strong);
  }

  .home-grid .project-grid {
    gap: 0.75rem;
  }

  .home-grid .project-card {
    display: flex;
    min-height: 10.5rem;
    flex-direction: column;
  }

  .home-grid .project-card__link {
