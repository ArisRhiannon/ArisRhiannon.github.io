							<img 
								src="https://avatars.githubusercontent.com/u/220097246?v=4" 
								alt="Aris Rhiannon" 
								class="w-full h-full rounded-full object-cover filter saturate-75 contrast-110 shadow-inner group-hover:scale-105 transition-transform" 
							/>
							<div class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-[#faf7f2] border border-[#e6dec9] flex items-center justify-center">
								<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] animate-pulse"></span>
							</div>
						</div>
						<div class="space-y-1">
							<h1 class="font-display text-base tracking-[0.05em] font-semibold text-[#2c241e] leading-tight">
								ARIS RHIANNON
							</h1>
							<span class="font-mono text-[9px] text-[#b58b4c] uppercase tracking-widest block">
								@ArisRhiannon
							</span>
							<div class="flex gap-2.5 pt-1.5">
								<a href="https://github.com/ArisRhiannon" class="text-[#b58b4c] hover:text-[#2c241e] transition-colors" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
