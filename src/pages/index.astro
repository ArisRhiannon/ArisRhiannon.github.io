				<a href="/" class="flex flex-col">
					<span class="font-display text-sm tracking-[0.15em] font-semibold text-[#2c241e]">
						ARIS RHIANNON
					</span>
					<span class="font-mono text-[8px] text-[#b58b4c] uppercase tracking-wider mt-0.5">Development Portfolio</span>
				</a>
				<button 
					id="menu-toggle"
					class="p-2 border border-[#e6dec9] rounded bg-[#faf7f2]/50 hover:bg-[#faf7f2] hover:border-[#b58b4c] transition-colors focus:outline-none"
					aria-label="Toggle menu"
				>
					<svg class="w-5 h-5 text-[#2c241e]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</header>

			{/* MOBILE NAVIGATION OVERLAY */}
			<div 
				id="mobile-menu"
				class="hidden fixed inset-0 z-40 bg-[#faf7f2] pt-24 px-8 flex flex-col justify-between pb-12 animate-fade-in"
			>
				<div class="space-y-10">
					{/* Profile Header in Mobile Drawer */}
					<div class="flex items-center gap-4 border-b border-[#e6dec9]/40 pb-6">
						<div class="w-14 h-14 rounded-full border border-[#b58b4c]/30 p-1 flex items-center justify-center bg-[#faf7f2]">
							<img 
								src="https://avatars.githubusercontent.com/u/220097246?v=4" 
								alt="Aris Rhiannon" 
								class="w-full h-full rounded-full object-cover filter saturate-75 contrast-110" 
							/>
						</div>
						<div class="space-y-1 flex-1">
							<span class="font-display text-sm tracking-[0.05em] font-semibold text-[#2c241e] block">
								ARIS RHIANNON
							</span>
							<span class="font-mono text-[8px] text-[#b58b4c] uppercase tracking-widest block">
