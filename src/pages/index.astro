---
import ProjectCard from '../components/ProjectCard.astro';
import FAQItem from '../components/FAQItem.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Aris Rhiannon — Proyectos y Desarrollo</title>
		<meta name="description" content="Sitio web personal de Aris Rhiannon. Auditoría de seguridad npm, SAST para código generado por IA y parches de traducción." />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#faf7f2] text-[#2c241e] font-serif selection:bg-[#b58b4c]/20 selection:text-[#5c4018] min-h-screen relative overflow-x-hidden">
		
		{/* Subtle top background gold glow */}
		<div class="absolute top-0 right-0 w-full lg:w-[calc(100%-280px)] h-[400px] bg-[radial-gradient(circle_at_top_right,rgba(181,139,76,0.06)_0%,transparent_60%)] pointer-events-none z-0"></div>

		{/* Responsive Layout Grid */}
		<div class="lg:grid lg:grid-cols-[280px_1fr] min-h-screen relative z-10">
			
			{/* MOBILE HEADER */}
			<header class="lg:hidden sticky top-0 z-50 bg-[#faf7f2]/95 border-b border-[#e6dec9]/60 backdrop-blur-md px-6 py-4 flex justify-between items-center">
				<a href="/" class="flex flex-col">
					<span class="font-display text-sm tracking-[0.15em] font-semibold text-[#2c241e]">
						ARIS RHIANNON
					</span>
					<span class="font-mono text-[8px] text-[#b58b4c] uppercase tracking-wider mt-0.5">Development Portfolio</span>
				</a>
				<button 
					id="menu-toggle"
					class="p-2 border border-[#e6dec9] rounded bg-[#faf7f2]/50 hover:bg-[#faf7f2] hover:border-[#b58b4c] transition-colors focus:outline-none"
					aria-label="Toggle menu"
				>
					<svg class="w-5 h-5 text-[#2c241e]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</header>

			{/* MOBILE NAVIGATION OVERLAY */}
			<div 
				id="mobile-menu"
				class="hidden fixed inset-0 z-40 bg-[#faf7f2] pt-20 px-8 flex flex-col justify-between pb-12 animate-fade-in"
			>
				<nav class="flex flex-col gap-6 text-center font-display text-xl tracking-wider text-[#2c241e]">
					<a href="#presentacion" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">Sobre Mí</a>
					<a href="#proyectos" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">Proyectos</a>
					<a href="#descargas" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">Descargas</a>
					<a href="#faq" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">FAQ</a>
				</nav>
				
				<div class="flex flex-wrap justify-center gap-x-6 gap-y-2 font-mono text-[10px] text-[#7c6e62] uppercase tracking-widest">
					<a href="https://github.com/ArisRhiannon" class="hover:text-[#b58b4c]" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="https://x.com/goddamnBern" class="hover:text-[#b58b4c]" target="_blank" rel="noopener noreferrer">X / Twitter</a>
					<a href="https://www.youtube.com/@GoddamnBernkastel" class="hover:text-[#b58b4c]" target="_blank" rel="noopener noreferrer">YouTube</a>
					<a href="https://discord.com/users/aris_rhiannon" class="hover:text-[#b58b4c]" target="_blank" rel="noopener noreferrer">Discord</a>
				</div>
			</div>

			{/* DESKTOP STICKY SIDEBAR */}
			<aside class="hidden lg:flex flex-col justify-between sticky top-0 h-screen bg-[#faf7f2] border-r border-[#e6dec9]/60 p-8 z-30 select-none">
				<div class="space-y-10">
					{/* Profile / Branding */}
					<div class="space-y-4">
						<div class="w-16 h-16 rounded-full border border-[#b58b4c]/30 p-1 flex items-center justify-center bg-[#faf7f2] relative group">
							<img 
								src="https://avatars.githubusercontent.com/u/220097246?v=4" 
								alt="Aris Rhiannon" 
								class="w-full h-full rounded-full object-cover filter saturate-75 contrast-110 shadow-inner group-hover:scale-105 transition-transform" 
							/>
							<div class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-[#faf7f2] border border-[#e6dec9] flex items-center justify-center">
								<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] animate-pulse"></span>
							</div>
						</div>
						<div>
							<h1 class="font-display text-lg tracking-[0.1em] font-semibold text-[#2c241e] leading-tight">
								ARIS RHIANNON
							</h1>
							<span class="font-mono text-[9px] text-[#b58b4c] uppercase tracking-widest block mt-0.5">
								@ArisRhiannon
							</span>
						</div>
					</div>

					{/* Navigation */}
					<nav class="flex flex-col gap-3 font-mono text-[11px] uppercase tracking-widest text-[#7c6e62]">
						<a href="#presentacion" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							Sobre Mí
						</a>
						<a href="#proyectos" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							Proyectos
						</a>
						<a href="#descargas" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							Descargas
						</a>
						<a href="#faq" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							FAQ
						</a>
					</nav>
				</div>

				{/* Footer/Social Links */}
				<div class="space-y-4 font-mono text-[10px] text-[#7c6e62] tracking-widest">
					<div class="flex flex-col gap-2">
						<a href="https://github.com/ArisRhiannon" class="hover:text-[#2c241e] transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
						<a href="https://x.com/goddamnBern" class="hover:text-[#2c241e] transition-colors" target="_blank" rel="noopener noreferrer">X / Twitter</a>
						<a href="https://www.youtube.com/@GoddamnBernkastel" class="hover:text-[#2c241e] transition-colors" target="_blank" rel="noopener noreferrer">YouTube</a>
						<a href="https://discord.com/users/aris_rhiannon" class="hover:text-[#2c241e] transition-colors" target="_blank" rel="noopener noreferrer">Discord</a>
					</div>
					<p class="text-[9px] text-[#a09082] leading-relaxed uppercase">
						© 2026. Aris Rhiannon.
					</p>
				</div>
			</aside>

			{/* MAIN CONTENT COLUMN */}
			<main class="max-w-4xl px-6 py-12 md:px-12 md:py-20 space-y-24">
				
				{/* WELCOME / PRESENTATION */}
				<section id="presentacion" class="scroll-mt-24 space-y-6">
					<div class="space-y-2">
						<span class="font-mono text-[10px] text-[#b58b4c] uppercase tracking-widest">Introducción</span>
						<h2 class="font-display text-2xl sm:text-4xl text-[#2c241e] uppercase tracking-wide">
							Sobre Mí
						</h2>
					</div>
					
					<p class="text-base sm:text-lg text-[#4a3e37] italic leading-relaxed max-w-2xl border-l-2 border-[#b58b4c]/30 pl-4 py-1">
						«El futuro tiene muchos nombres. Para los débiles es lo inalcanzable. Para los temerosos, lo desconocido. Para los valientes es la oportunidad.»
						<span class="block text-xs text-[#7c6e62] font-mono not-italic mt-2">— Victor Hugo, Les Misérables</span>
					</p>
					
					<div class="flex gap-4 pt-2">
						<a 
							href="#proyectos" 
							class="px-5 py-2.5 font-mono text-[10px] uppercase tracking-widest text-white bg-[#b58b4c] hover:bg-[#997236] rounded-sm transition-colors shadow-sm"
						>
							Proyectos
						</a>
						<a 
							href="#descargas" 
							class="px-5 py-2.5 font-mono text-[10px] uppercase tracking-widest text-[#b58b4c] border border-[#e6dec9] hover:bg-[#b58b4c]/5 rounded-sm transition-colors"
						>
							Descargas
						</a>
					</div>
				</section>

				{/* DECORATIVE LINE */}
				<div class="h-[1px] bg-gradient-to-r from-[#e6dec9] via-transparent to-transparent"></div>

				{/* PROJECTS SECTION */}
				<section id="proyectos" class="scroll-mt-24 space-y-8">
					<div class="space-y-1">
						<span class="font-mono text-[10px] text-[#b58b4c] uppercase tracking-widest">Catálogo</span>
						<h3 class="font-display text-xl sm:text-2xl text-[#2c241e] uppercase tracking-wider">Proyectos Activos</h3>
					</div>

					<div class="grid grid-cols-1 gap-6">
						<ProjectCard 
							title="Ciconia When They Cry Phase 1"
							subtitle="Traducción al Español"
							description="Adaptación literaria y técnica no oficial de 'For You, the Replaceable Ones' de 07th Expansion. Localización completa de textos de diálogo, rótulos de interfaz de batalla y glosario terminológico."
							status="En desarrollo"
							link="#descargas"
						/>
					</div>
				</section>



				{/* DECORATIVE LINE */}
				<div class="h-[1px] bg-gradient-to-r from-[#e6dec9] via-transparent to-transparent"></div>

				{/* DOWNLOADS SECTION */}
				<section id="descargas" class="scroll-mt-24 space-y-8">
					<div class="space-y-1">
						<span class="font-mono text-[10px] text-[#b58b4c] uppercase tracking-widest">Repositorio</span>
						<h3 class="font-display text-xl sm:text-2xl text-[#2c241e] uppercase tracking-wider">Centro de Descargas</h3>
					</div>

					<div class="overflow-x-auto">
						<table class="w-full text-left font-serif text-sm border-collapse">
							<thead>
								<tr class="border-b border-[#e6dec9] text-[#7c6e62] font-mono text-[9px] sm:text-[10px] uppercase tracking-wider">
									<th class="py-3 px-2">Proyecto</th>
									<th class="py-3 px-2">Versión</th>
									<th class="py-3 px-2">Tipo de Archivo</th>
									<th class="py-3 px-2 text-right">Enlace</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-[#e6dec9]/40 text-[#4a3e37]">
								<tr class="hover:bg-[#fdfcf7]/40 transition-colors">
									<td class="py-4 px-2 font-display text-xs sm:text-sm text-[#2c241e] tracking-wide">Ciconia Phase 1 Patch ES</td>
									<td class="py-4 px-2 font-mono text-xs text-[#7c6e62]">v1.0.0-alpha</td>
									<td class="py-4 px-2 text-xs">Parche local de traducción</td>
									<td class="py-4 px-2 text-right">
										<span class="font-mono text-[9px] text-[#a09082] uppercase tracking-wider">Próximamente</span>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				{/* DECORATIVE LINE */}
				<div class="h-[1px] bg-gradient-to-r from-[#e6dec9] via-transparent to-transparent"></div>

				{/* FAQ SECTION */}
				<section id="faq" class="scroll-mt-24 space-y-8">
					<div class="space-y-1">
						<span class="font-mono text-[10px] text-[#b58b4c] uppercase tracking-widest">Ayuda</span>
						<h3 class="font-display text-xl sm:text-2xl text-[#2c241e] uppercase tracking-wider">Preguntas Frecuentes</h3>
					</div>

					<div class="space-y-4">
						<FAQItem 
							id="1"
							question="¿Son gratuitos los parches de traducción?" 
							answer="Sí. Todo el trabajo de traducción y herramientas de localización al español se distribuye de forma 100% gratuita. Por favor, apoya al creador oficial Ryukishi07 comprando la versión legítima del juego en Steam." 
						/>
						<FAQItem 
							id="2"
							question="¿Cómo se instala el parche de Ciconia?" 
							answer="Una vez lanzado el parche de traducción, se distribuirá como un paquete comprimido. Solo deberás arrastrar y soltar los archivos del parche dentro del directorio principal de instalación de Ciconia en Steam para jugar inmediatamente en español." 
						/>
						<FAQItem 
							id="3"
							question="¿Cómo puedo ponerme en contacto o reportar errores?" 
							answer="Para cualquier reporte de bugs o para sugerir correcciones en el parche de traducción de Ciconia, puedes abrir un Issue directamente en mi perfil de GitHub o escribirme por Discord." 
						/>
					</div>
				</section>

				{/* MOBILE ONLY FOOTER */}
				<footer class="lg:hidden border-t border-[#e6dec9]/40 pt-8 font-mono text-[9px] text-[#a09082] text-center space-y-2 uppercase tracking-widest">
					<p>© 2026. Aris Rhiannon.</p>
					<p class="font-serif lowercase italic text-[#b58b4c]">Higurashi, Umineko y Ciconia pertenecen a 07th Expansion y MangaGamer.</p>
				</footer>

			</main>
		</div>

		{/* JavaScript for Responsive Navigation menu */}
		<script>
			const toggle = document.getElementById('menu-toggle');
			const menu = document.getElementById('mobile-menu');
			
			if (toggle && menu) {
				toggle.addEventListener('click', () => {
					menu.classList.toggle('hidden');
					document.body.classList.toggle('overflow-hidden');
				});

				// Close menu when clicking navigation links
				const links = menu.querySelectorAll('.mobile-nav-link');
				links.forEach(link => {
					link.addEventListener('click', () => {
						menu.classList.add('hidden');
						document.body.classList.remove('overflow-hidden');
					});
				});
			}

			// Active link styling on Desktop scroll
			const sections = document.querySelectorAll('section');
			const navLinks = document.querySelectorAll('.nav-link');

			window.addEventListener('scroll', () => {
				let current = '';
				sections.forEach(section => {
					const sectionTop = section.offsetTop;
					if (window.scrollY >= sectionTop - 150) {
						current = section.getAttribute('id') || '';
					}
				});

				navLinks.forEach(link => {
					const href = link.getAttribute('href');
					const marker = link.querySelector('span');
					if (href === `#${current}`) {
						link.classList.add('text-[#2c241e]', 'font-semibold');
						link.classList.remove('text-[#7c6e62]');
						if (marker) marker.classList.remove('opacity-0');
					} else {
						link.classList.remove('text-[#2c241e]', 'font-semibold');
						link.classList.add('text-[#7c6e62]');
						if (marker) marker.classList.add('opacity-0');
					}
				});
			});
		</script>

		<style>
			@keyframes fade-in {
				from { opacity: 0; transform: translateY(-10px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.animate-fade-in {
				animation: fade-in 0.25s ease-out forwards;
			}
		</style>
	</body>
</html>
