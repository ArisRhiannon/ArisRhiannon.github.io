---
import ProjectCard from '../components/ProjectCard.astro';
import FAQItem from '../components/FAQItem.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Aris Rhiannon — Proyectos y Desarrollo</title>
		<meta name="description" content="Sitio web personal de Aris Rhiannon. Auditoría de seguridad npm, SAST para código generado por IA y parches de traducción." />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#faf7f2] text-[#2c241e] font-serif selection:bg-[#b58b4c]/20 selection:text-[#5c4018] min-h-screen relative overflow-x-hidden">
		
		{/* Vintage Double-Line Viewport Border Frame */}
		<div class="fixed inset-2 sm:inset-4 pointer-events-none border border-[#e6dec9]/60 z-50 rounded-sm"></div>
		<div class="fixed inset-3 sm:inset-[18px] pointer-events-none border border-[#b58b4c]/10 z-50 rounded-sm"></div>

		{/* Subtle top background gold glow */}
		<div class="absolute top-0 right-0 w-full lg:w-[calc(100%-280px)] h-[400px] bg-[radial-gradient(circle_at_top_right,rgba(181,139,76,0.06)_0%,transparent_60%)] pointer-events-none z-0"></div>

		{/* Responsive Layout Grid */}
		<div class="lg:grid lg:grid-cols-[280px_1fr] min-h-screen relative z-10">
			
			{/* MOBILE HEADER */}
			<header class="lg:hidden sticky top-0 z-50 bg-[#faf7f2]/95 border-b border-[#e6dec9]/60 backdrop-blur-md px-6 py-4 flex justify-between items-center">
				<a href="/" class="flex flex-col">
					<span class="font-display text-sm tracking-[0.15em] font-semibold text-[#2c241e]">
						ARIS RHIANNON
					</span>
					<span class="font-mono text-[8px] text-[#b58b4c] uppercase tracking-wider mt-0.5">Development Portfolio</span>
				</a>
				<button 
					id="menu-toggle"
					class="p-2 border border-[#e6dec9] rounded bg-[#faf7f2]/50 hover:bg-[#faf7f2] hover:border-[#b58b4c] transition-colors focus:outline-none"
					aria-label="Toggle menu"
				>
					<svg class="w-5 h-5 text-[#2c241e]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</header>

			{/* MOBILE NAVIGATION OVERLAY */}
			<div 
				id="mobile-menu"
				class="hidden fixed inset-0 z-40 bg-[#faf7f2] pt-24 px-8 flex flex-col justify-between pb-12 animate-fade-in"
			>
				<div class="space-y-10">
					{/* Profile Header in Mobile Drawer */}
					<div class="flex flex-col gap-4 border-b border-[#e6dec9]/40 pb-6">
						<div class="flex items-center gap-4">
							<div class="w-14 h-14 rounded-full border border-[#b58b4c]/30 p-1 flex items-center justify-center bg-[#faf7f2]">
								<img 
									src="https://avatars.githubusercontent.com/u/220097246?v=4" 
									alt="Aris Rhiannon" 
									class="w-full h-full rounded-full object-cover filter saturate-75 contrast-110" 
								/>
							</div>
							<div>
								<span class="font-display text-sm tracking-[0.05em] font-semibold text-[#2c241e] block">
									ARIS RHIANNON
								</span>
								<span class="font-mono text-[8px] text-[#b58b4c] uppercase tracking-widest block">
									@ArisRhiannon
								</span>
							</div>
						</div>
						
						{/* Naked Social Links List (Mobile) */}
						<div class="bg-[#fdfcf7]/60 border border-[#e6dec9]/60 rounded-md p-3.5 space-y-2.5 font-mono text-[9px] text-[#7c6e62] select-text">
							<span class="block text-[8px] text-[#b58b4c] uppercase tracking-[0.15em] font-bold border-b border-[#e6dec9]/40 pb-1 mb-1.5">Canales y Contacto</span>
							
							<a href="https://github.com/ArisRhiannon" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
								<span class="truncate group-hover:underline">github.com/ArisRhiannon</span>
							</a>
							
							<a href="https://x.com/goddamnBern" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
								<span class="truncate group-hover:underline">x.com/goddamnBern</span>
							</a>
							
							<a href="https://www.youtube.com/@GoddamnBernkastel" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12.07a29 29 0 0 0 .46 5.65 2.78 2.78 0 0 0 1.95 1.96c1.71.46 8.59.46 8.59.46s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96 29 29 0 0 0 .46-5.65 29 29 0 0 0-.46-5.65z"></path><polygon points="9.75 15.02 15.5 12.07 9.75 9.13 9.75 15.02"></polygon></svg>
								<span class="truncate group-hover:underline">youtube.com/@GoddamnBernkastel</span>
							</a>
							
							<a href="https://discord.com/users/aris_rhiannon" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 127.14 96.36" fill="currentColor"><path d="M107.7,8.07A105.15,105.15,0,0,0,77.26,0a77.19,77.19,0,0,0-3.3,6.83A96.67,96.67,0,0,0,53.22,6.83,77.19,77.19,0,0,0,49.88,0,105.15,105.15,0,0,0,19.44,8.07C3.66,31.58-1.86,54.65,1,77.53A105.73,105.73,0,0,0,32,96.36a77.7,77.7,0,0,0,6.63-10.85,68.43,68.43,0,0,1-10.5-5c.89-.65,1.76-1.34,2.58-2.07a75.48,75.48,0,0,0,72.9,0c.82.73,1.69,1.42,2.58,2.07a68.43,68.43,0,0,1-10.5,5,77.7,77.7,0,0,0,6.63,10.85,105.73,105.73,0,0,0,31.06-18.83C129,54.65,123.5,31.58,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53S36.18,40.36,42.45,40.36,53.83,46,53.83,53,48.72,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.24,60,73.24,53S78.41,40.36,84.69,40.36,96.07,46,96.07,53,91,65.69,84.69,65.69Z"/></svg>
								<span class="truncate group-hover:underline">discord.com/users/aris_rhiannon</span>
							</a>
						</div>
					</div>

					<nav class="flex flex-col gap-6 font-display text-lg tracking-wider text-[#2c241e]">
						<a href="#presentacion" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">Sobre Mí</a>
						<a href="#proyectos" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">Proyectos</a>
						<a href="#descargas" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">Descargas</a>
						<a href="#faq" class="mobile-nav-link hover:text-[#b58b4c] transition-colors">FAQ</a>
					</nav>
				</div>
			</div>

			{/* DESKTOP STICKY SIDEBAR */}
			<aside class="hidden lg:flex flex-col justify-between sticky top-0 h-screen bg-[#faf7f2] border-r border-[#e6dec9]/60 p-8 z-30 select-none">
				<div class="space-y-10">
					<div class="flex flex-col gap-4">
						<div class="flex items-center gap-4">
							<div class="w-16 h-16 rounded-full border border-[#b58b4c]/30 p-1 flex items-center justify-center bg-[#faf7f2] relative group flex-shrink-0">
								<img 
									src="https://avatars.githubusercontent.com/u/220097246?v=4" 
									alt="Aris Rhiannon" 
									class="w-full h-full rounded-full object-cover filter saturate-75 contrast-110 shadow-inner group-hover:scale-105 transition-transform" 
								/>
								<div class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-[#faf7f2] border border-[#e6dec9] flex items-center justify-center">
									<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] animate-pulse"></span>
								</div>
							</div>
							<div>
								<h1 class="font-display text-base tracking-[0.05em] font-semibold text-[#2c241e] leading-tight">
									ARIS RHIANNON
								</h1>
								<span class="font-mono text-[9px] text-[#b58b4c] uppercase tracking-widest block">
									@ArisRhiannon
								</span>
							</div>
						</div>

						{/* Naked Social Links Container */}
						<div class="bg-[#fdfcf7]/60 border border-[#e6dec9]/60 rounded-md p-3.5 space-y-2.5 font-mono text-[9px] text-[#7c6e62] select-text">
							<span class="block text-[8px] text-[#b58b4c] uppercase tracking-[0.15em] font-bold border-b border-[#e6dec9]/40 pb-1 mb-1.5">Canales y Contacto</span>
							
							<a href="https://github.com/ArisRhiannon" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
								<span class="truncate group-hover:underline">github.com/ArisRhiannon</span>
							</a>
							
							<a href="https://x.com/goddamnBern" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
								<span class="truncate group-hover:underline">x.com/goddamnBern</span>
							</a>
							
							<a href="https://www.youtube.com/@GoddamnBernkastel" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12.07a29 29 0 0 0 .46 5.65 2.78 2.78 0 0 0 1.95 1.96c1.71.46 8.59.46 8.59.46s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96 29 29 0 0 0 .46-5.65 29 29 0 0 0-.46-5.65z"></path><polygon points="9.75 15.02 15.5 12.07 9.75 9.13 9.75 15.02"></polygon></svg>
								<span class="truncate group-hover:underline">youtube.com/@GoddamnBernkastel</span>
							</a>
							
							<a href="https://discord.com/users/aris_rhiannon" class="flex items-center gap-2 hover:text-[#2c241e] transition-colors py-0.5 group" target="_blank" rel="noopener noreferrer">
								<svg class="w-3.5 h-3.5 text-[#b58b4c]/80 group-hover:text-[#b58b4c] flex-shrink-0" viewBox="0 0 127.14 96.36" fill="currentColor"><path d="M107.7,8.07A105.15,105.15,0,0,0,77.26,0a77.19,77.19,0,0,0-3.3,6.83A96.67,96.67,0,0,0,53.22,6.83,77.19,77.19,0,0,0,49.88,0,105.15,105.15,0,0,0,19.44,8.07C3.66,31.58-1.86,54.65,1,77.53A105.73,105.73,0,0,0,32,96.36a77.7,77.7,0,0,0,6.63-10.85,68.43,68.43,0,0,1-10.5-5c.89-.65,1.76-1.34,2.58-2.07a75.48,75.48,0,0,0,72.9,0c.82.73,1.69,1.42,2.58,2.07a68.43,68.43,0,0,1-10.5,5,77.7,77.7,0,0,0,6.63,10.85,105.73,105.73,0,0,0,31.06-18.83C129,54.65,123.5,31.58,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53S36.18,40.36,42.45,40.36,53.83,46,53.83,53,48.72,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.24,60,73.24,53S78.41,40.36,84.69,40.36,96.07,46,96.07,53,91,65.69,84.69,65.69Z"/></svg>
								<span class="truncate group-hover:underline">discord.com/users/aris_rhiannon</span>
							</a>
						</div>
					</div>

					{/* Navigation */}
					<nav class="flex flex-col gap-3 font-mono text-[11px] uppercase tracking-widest text-[#7c6e62]">
						<a href="#presentacion" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							Sobre Mí
						</a>
						<a href="#proyectos" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							Proyectos
						</a>
						<a href="#descargas" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							Descargas
						</a>
						<a href="#faq" class="nav-link hover:text-[#2c241e] flex items-center gap-2 py-1 transition-colors">
							<span class="w-1.5 h-1.5 rounded-full bg-[#b58b4c] opacity-0 transition-opacity"></span>
							FAQ
						</a>
					</nav>
				</div>

				{/* Footer Copyright */}
				<div class="font-mono text-[9px] text-[#a09082] tracking-widest uppercase space-y-2">
					<p>© 2026. Aris Rhiannon.</p>
					<div class="pt-1 opacity-70 hover:opacity-100 transition-opacity">
						<img src="https://api.visitorbadge.io/api/VisitorHit?user=ArisRhiannon&repo=ArisRhiannon.github.io&label=visitas&labelColor=%237c6e62&countColor=%23b58b4c" alt="Contador de Visitas" class="h-4 select-none pointer-events-none" />
					</div>
				</div>
			</aside>

			{/* MAIN CONTENT COLUMN */}
			<main class="max-w-4xl px-6 sm:px-12 py-10 sm:py-16 space-y-16 relative z-10">
				
				{/* WELCOME / PRESENTATION */}
				<section id="presentacion" class="scroll-mt-24 space-y-6">
					<div class="space-y-2 border-b border-[#e6dec9]/60 pb-3">
						<span class="font-mono text-[9px] text-[#b58b4c] uppercase tracking-[0.2em] font-semibold">01 / Introducción</span>
						<h2 class="font-display text-2xl sm:text-3xl text-[#2c241e] uppercase tracking-wide">
							Sobre Mí
						</h2>
					</div>
					
					<div class="bg-gradient-to-br from-[#fdfcf7] to-[#f7f3e8] border border-[#e6dec9] p-6 sm:p-8 rounded-md relative shadow-sm max-w-2xl">
						<span class="font-display text-4xl text-[#b58b4c] leading-none absolute top-4 left-4 opacity-20 select-none">“</span>
						<p class="text-base sm:text-lg text-[#4a3e37] italic leading-relaxed pl-4 relative z-10">
							«El cerebro de Paimon está lleno de preguntas. Como... ¿cuál es el significado de la vida? Y... ¿qué hay de comer?»
						</p>
						<span class="block text-right text-xs text-[#7c6e62] font-mono not-italic mt-4 relative z-10">
							— Paimon, Genshin Impact
						</span>
					</div>
					
					<div class="flex gap-4 pt-2">
						<a 
							href="#proyectos" 
							class="px-5 py-2.5 font-mono text-[10px] uppercase tracking-widest text-white bg-[#b58b4c] hover:bg-[#997236] rounded-sm transition-colors shadow-sm"
						>
							Proyectos
						</a>
						<a 
							href="#descargas" 
							class="px-5 py-2.5 font-mono text-[10px] uppercase tracking-widest text-[#b58b4c] border border-[#e6dec9] hover:bg-[#b58b4c]/5 rounded-sm transition-colors"
						>
							Descargas
						</a>
					</div>
				</section>

				{/* DECORATIVE DIVIDER */}
				<div class="flex items-center justify-center gap-4 py-2 select-none max-w-2xl" aria-hidden="true">
					<div class="h-[1px] w-full bg-gradient-to-r from-transparent to-[#e6dec9]/60"></div>
					<span class="text-[#b58b4c]/70 font-mono text-[8px] tracking-widest">◇</span>
					<div class="h-[1px] w-full bg-gradient-to-l from-transparent to-[#e6dec9]/60"></div>
				</div>

				{/* PROJECTS SECTION */}
				<section id="proyectos" class="scroll-mt-24 space-y-6">
					<div class="space-y-2 border-b border-[#e6dec9]/60 pb-3">
						<span class="font-mono text-[9px] text-[#b58b4c] uppercase tracking-[0.2em] font-semibold">02 / Catálogo</span>
						<h3 class="font-display text-xl sm:text-2xl text-[#2c241e] uppercase tracking-wider">Proyectos Activos</h3>
					</div>

					<div class="grid grid-cols-1 gap-6">
						<ProjectCard 
							title="Ciconia When They Cry Phase 1"
							subtitle="Traducción al Español"
							description="Localización completa no oficial de 'For You, the Replaceable Ones' de 07th Expansion al español latinoamericano neutro. Más de 16,000 líneas de texto traducidas con adaptación literaria fiel al japonés."
							status="Disponible"
							link="#descargas"
						/>
					</div>
				</section>



				{/* DECORATIVE DIVIDER */}
				<div class="flex items-center justify-center gap-4 py-2 select-none max-w-2xl" aria-hidden="true">
					<div class="h-[1px] w-full bg-gradient-to-r from-transparent to-[#e6dec9]/60"></div>
					<span class="text-[#b58b4c]/70 font-mono text-[8px] tracking-widest">◇</span>
					<div class="h-[1px] w-full bg-gradient-to-l from-transparent to-[#e6dec9]/60"></div>
				</div>

				{/* DOWNLOADS SECTION */}
				<section id="descargas" class="scroll-mt-24 space-y-8">
					<div class="space-y-2 border-b border-[#e6dec9]/60 pb-3">
						<span class="font-mono text-[9px] text-[#b58b4c] uppercase tracking-[0.2em] font-semibold">03 / Descargar</span>
						<h3 class="font-display text-xl sm:text-2xl text-[#2c241e] uppercase tracking-wider">Ciconia Phase 1 — Parche al Español</h3>
