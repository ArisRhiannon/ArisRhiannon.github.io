---
import SiteLayout from '../layouts/SiteLayout.astro';

const archive = [
  {
    title: 'Rose Guns Days — Temporada 1',
    meta: 'Traducción · 2014',
    href: 'https://23rddistrict.wordpress.com/2014/12/20/rose-guns-days-season-1-version-final-al-espanol/',
  },
  {
    title: 'Umineko no Naku Koro ni — Hane',
    meta: 'Traducción · 2014',
    href: 'https://23rddistrict.wordpress.com/umineko-hane/',
  },
  {
    title: 'Higanbana no Saku Yoru ni — Primera Noche',
    meta: 'Traducción',
    href: 'https://utopiaclassroom.blogspot.com/p/primera-noche_13.html',
  },
  {
    title: 'Umineko Tsubasa — Carta de Bernkastel',
    meta: 'Video · 2016',
    href: 'https://www.youtube.com/watch?v=kyk1_C-pLuA',
  },
  {
    title: 'Higurashi no Naku Koro ni: Kizuna',
    meta: 'Video · 2018',
    href: 'https://youtu.be/7lJav3O3v_g',
  },
];

const SITE = 'https://arisrhiannon.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Aris Rhiannon',
      description: 'Parches y traducciones de novelas visuales al español latinoamericano.',
      inLanguage: 'es-419',
      publisher: { '@id': `${SITE}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#person`,
      name: 'Aris Rhiannon',
      url: `${SITE}/`,
      image: `${SITE}/favicon.png`,
      knowsLanguage: ['es', 'ja', 'en'],
      sameAs: [
        'https://github.com/ArisRhiannon',
        'https://x.com/goddamnBern',
        'https://www.youtube.com/@GoddamnBernkastel',
      ],
    },
  ],
};
---

<SiteLayout
  title="Aris Rhiannon — Parches y traducciones al español"
  description="Parches y traducciones de novelas visuales al español latinoamericano: TRianThology y Ciconia When They Cry, con instaladores para Windows."
  canonical="https://arisrhiannon.github.io/"
  jsonLd={jsonLd}
>
  <div class="page">
    <section class="hero" aria-labelledby="titulo-principal">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Parches y traducciones · es-419</span>
          <h1 id="titulo-principal" class="hero-title">Aris Rhiannon</h1>
          <p class="hero-lede">Traducciones de novelas visuales al español latinoamericano.</p>
          <div class="hero-actions">
            <a class="button button--primary" href="/trianthology/">TRianThology en español</a>
            <a class="button" href="/ciconia/">Descargar Ciconia</a>
          </div>
        </div>

        <aside class="brief" aria-label="Estado de los proyectos">
          <span class="eyebrow">Proyectos</span>
          <dl>
            <dt>TRianThology</dt>
            <dd>Disponible</dd>
            <dt>Ciconia</dt>
            <dd>Disponible</dd>
          </dl>
        </aside>
      </div>
    </section>

    <div class="home-grid">
      <section id="proyectos" class="section" aria-labelledby="titulo-proyectos">
        <div class="section-heading section-heading--compact">
          <div>
            <span class="eyebrow">Proyectos</span>
            <h2 id="titulo-proyectos">Parches</h2>
          </div>
        </div>

        <div class="project-grid">
          <article class="project-card project-card--featured project-card--art">
            <img
              class="project-card__thumb"
              src="/trianthology/alice-880.webp"
              width="880"
              height="495"
              loading="lazy"
              decoding="async"
              alt=""
            />
            <span class="status status--available">Disponible</span>
            <h3>TRianThology</h3>
            <p>Traducción completa de <cite>Alice of the Three-Sided Mirror</cite>, con instalador para Windows.</p>
            <a class="project-card__link" href="/trianthology/">Descargar el parche →</a>
          </article>

          <article class="project-card project-card--featured">
            <span class="status status--available">Disponible</span>
            <h3>Ciconia When They Cry: Phase 1</h3>
            <p>Traducción completa con instalador para Windows.</p>
            <a class="project-card__link" href="/ciconia/">Descargar el parche →</a>
          </article>
        </div>
      </section>

      <section id="archivo" class="section" aria-labelledby="titulo-archivo">
        <div class="section-heading section-heading--compact">
          <div>
            <span class="eyebrow">Archivo</span>
            <h2 id="titulo-archivo">Trabajos anteriores</h2>
          </div>
        </div>

        <ul class="archive-list">
          {archive.map((item) => (
            <li>
              <a href={item.href}>
                <span class="archive-list__title">{item.title}</span>
                <span class="archive-list__meta">{item.meta} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</SiteLayout>
