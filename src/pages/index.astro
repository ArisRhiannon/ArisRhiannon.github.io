---
import ProjectCard from '../components/ProjectCard.astro';
import FAQItem from '../components/FAQItem.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Aris Rhiannon — Proyectos y Desarrollo</title>
		<meta name="description" content="Sitio web personal de Aris Rhiannon. Auditoría de seguridad npm, SAST para código generado por IA y parches de traducción." />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#faf7f2] text-[#2c241e] font-serif selection:bg-[#b58b4c]/20 selection:text-[#5c4018] min-h-screen relative overflow-x-hidden">
		
		{/* Subtle top background gold glow */}
		<div class="absolute top-0 right-0 w-full lg:w-[calc(100%-280px)] h-[400px] bg-[radial-gradient(circle_at_top_right,rgba(181,139,76,0.06)_0%,transparent_60%)] pointer-events-none z-0"></div>

		{/* Responsive Layout Grid */}
		<div class="lg:grid lg:grid-cols-[280px_1fr] min-h-screen relative z-10">
			
