---
import SiteLayout from '../layouts/SiteLayout.astro';

const stories = [
  {
    suit: '♦',
    title: 'Country Girl',
    author: 'Tanaka Romeo',
    text: 'Keiko, Mikihiko y un pueblo que cambia con el tiempo.',
  },
  {
    suit: '♥',
    title: 'Academy Love Adventure',
    author: 'Tonokawa Yūto',
    text: 'Una comedia escolar que juega con las reglas de su propio género.',
  },
  {
    suit: '♠',
    title: 'Vespio 2438',
    author: 'Ryukishi07',
    text: 'El escuadrón Fox ante una guerra que no admite respuestas sencillas.',
  },
  {
    suit: '♣',
    title: 'Alice y Usagi',
    author: 'Historia marco',
    text: 'El salón desde el que ambas recorren los tres fragmentos.',
  },
];

const patchDownload = 'https://github.com/ArisRhiannon/trianthology-es/releases/latest/download/Instalar-Parche-TrianThology-ES.exe';
---

<SiteLayout
  title="TrianThology en español | Aris Rhiannon"
  description="Parche al español latinoamericano de TrianThology: Alice of the Three-Sided Mirror."
  canonical="https://arisrhiannon.github.io/trianthology/"
  image="https://07th-expansion.net/wp-content/uploads/slider13/_0016_Alice1.jpeg"
  theme="trianthology"
>
  <link slot="head" rel="stylesheet" href="/trianthology/alice-night.css" />

  <div class="trian-page">
    <div class="cityscape" aria-hidden="true">
      <div class="cityscape-art"></div>
    </div>
    <canvas class="rain" data-rain aria-hidden="true"></canvas>

    <div class="moon" aria-hidden="true"></div>
    <div class="shards" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>

    <section class="landing" aria-labelledby="titulo-trianthology">
      <div class="hero-copy">
        <p class="kicker">Parche al español latinoamericano · es-419</p>
        <h1 id="titulo-trianthology">
          <span class="title-tri">Tri</span>an<span class="title-thology">Thology</span>
        </h1>
        <p class="subtitle">Alice of the Three-Sided Mirror</p>

        <div class="hero-actions">
          <a class="primary-action" href={patchDownload} download="Instalar-Parche-TrianThology-ES.exe">Descargar parche</a>
          <a class="secondary-action" href="#estado">Estado del parche</a>
          <span class="availability">
            <span aria-hidden="true"></span>
            Disponible públicamente
          </span>
        </div>

        <nav class="story-menu" aria-label="Relatos incluidos">
          {stories.map((story) => (
            <a href={`#${story.title.toLowerCase().replaceAll(' ', '-')}`}>
              <span class:list={['menu-suit', { red: story.suit === '♦' || story.suit === '♥' }]} aria-hidden="true">
                {story.suit}
              </span>
              <span>{story.title}</span>
            </a>
          ))}
        </nav>

        <div class="hero-meta" aria-label="Ficha rápida">
          <span>v0.1.23</span>
          <span>Windows</span>
          <span>18 056 segmentos</span>
          <span>412 gráficos</span>
        </div>
      </div>
    </section>

    <section class="fragment-section" aria-labelledby="titulo-fragmentos">
      <header class="section-head">
        <div>
          <span class="section-mark" aria-hidden="true">◇</span>
          <p class="kicker">Fragmentos</p>
          <h2 id="titulo-fragmentos">Tres historias</h2>
        </div>
      </header>

      <div class="fragment-grid">
        {stories.map((story, index) => (
          <article id={story.title.toLowerCase().replaceAll(' ', '-')} class="fragment">
            <span class:list={['fragment-suit', { red: story.suit === '♦' || story.suit === '♥' }]} aria-hidden="true">
              {story.suit}
            </span>
            <div>
              <p class="fragment-author">{story.author}</p>
              <h3>{story.title}</h3>
              <p>{story.text}</p>
            </div>
            <span class="fragment-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="estado" class="status-section" aria-labelledby="titulo-estado">
      <div class="status-copy">
        <p class="kicker">Estado actual</p>
        <h2 id="titulo-estado">Traducción completa</h2>
        <p>
          El repositorio y la descarga pública ya están disponibles. Necesitarás una copia
          propia del juego para aplicar el parche.
        </p>
      </div>

      <dl class="status-list">
        <div>
          <dt>Versión</dt>
          <dd>0.1.23</dd>
        </div>
        <div>
          <dt>Texto</dt>
          <dd>18 056 segmentos</dd>
        </div>
        <div>
          <dt>Imágenes</dt>
          <dd>412 recursos localizados</dd>
        </div>
        <div>
          <dt>Distribución</dt>
          <dd>Instalador para Windows</dd>
        </div>
      </dl>

      <div class="release-note">
        <span class="release-glyph" aria-hidden="true">◈</span>
        <div>
          <strong>Disponible</strong>
          <p>
            <a class="release-link" href={patchDownload} download="Instalar-Parche-TrianThology-ES.exe">
              Descargar el instalador desde GitHub
            </a>
            Necesitarás una copia propia del juego.
          </p>
        </div>
      </div>
    </section>

    <footer class="project-credits">
      <p><strong>Traducción y parche</strong> Aris Rhiannon</p>
      <p>
        <strong>Edición de imágenes</strong>
        <a href="https://x.com/nitronnix">NitroNNIx</a>
      </p>
      <p class="license-line">
        <strong>Licencias</strong>
        <a href="https://github.com/ArisRhiannon/trianthology-es/blob/main/LICENSE.translation">Traducción: CC BY-NC-SA 4.0</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/ArisRhiannon/trianthology-es/blob/main/LICENSE">Código: AGPL-3.0-or-later</a>
        <span aria-hidden="true">·</span>
        Obra original: 07th Expansion / Ryukishi07.
      </p>
      <span class="suits" aria-hidden="true">♠ <b>♥</b> ♣ <b>♦</b></span>
    </footer>
  </div>
</SiteLayout>

<script>
  const rainCanvas = document.querySelector('[data-rain]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (rainCanvas instanceof HTMLCanvasElement && !reduceMotion.matches) {
    const rainContext = rainCanvas.getContext('2d', { alpha: true, desynchronized: true });

    if (rainContext) {
      let width = 0;
      let height = 0;
      let pixelRatio = 1;
      let drops = [];
      let splashes = [];
      let animationFrame = 0;
      let previousTime = performance.now();

      const makeDrop = (y = -24) => {
        const depth = 0.25 + Math.random() * 0.75;
        return {
          x: Math.random() * width,
          y,
          length: 8 + depth * 19,
          speed: 250 + depth * 330,
          drift: 0.14 + depth * 0.24,
          width: 0.35 + depth * 0.65,
          alpha: 0.1 + depth * 0.21,
        };
      };

      const resizeRain = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        rainCanvas.width = Math.max(1, Math.floor(width * pixelRatio));
        rainCanvas.height = Math.max(1, Math.floor(height * pixelRatio));
        rainContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

        const count = Math.min(420, Math.max(120, Math.floor(width / 4.8)));
        drops = Array.from({ length: count }, () => makeDrop(Math.random() * height));
        splashes = [];
      };

      const addSplash = (x, size) => {
        if (splashes.length >= 34) splashes.shift();
        splashes.push({ x, size, age: 0 });
      };

      const drawSplash = (splash) => {
        const progress = splash.age / 0.42;
        const fade = 1 - progress;
        const spread = splash.size * (0.7 + progress * 2.4);
        const ground = height - 1;

        rainContext.strokeStyle = `rgba(188, 220, 246, ${fade * 0.38})`;
        rainContext.lineWidth = 0.55 + fade * 0.45;
        rainContext.beginPath();
        rainContext.ellipse(splash.x, ground, spread, 1.2 + progress * 1.8, 0, Math.PI, Math.PI * 2);
        rainContext.stroke();

        rainContext.strokeStyle = `rgba(220, 237, 255, ${fade * 0.3})`;
        rainContext.beginPath();
        rainContext.moveTo(splash.x - spread * 0.28, ground - 1);
        rainContext.lineTo(splash.x - spread * 0.42, ground - 4 - fade * 2);
        rainContext.moveTo(splash.x + spread * 0.28, ground - 1);
        rainContext.lineTo(splash.x + spread * 0.42, ground - 4 - fade * 2);
        rainContext.stroke();
      };

      const drawRain = (time) => {
        const delta = Math.min(0.034, Math.max(0.001, (time - previousTime) / 1000));
        previousTime = time;
        rainContext.clearRect(0, 0, width, height);

        const groundGlow = rainContext.createLinearGradient(0, height - 76, 0, height);
        groundGlow.addColorStop(0, 'rgba(93, 144, 191, 0)');
        groundGlow.addColorStop(1, 'rgba(104, 157, 204, 0.11)');
        rainContext.fillStyle = groundGlow;
        rainContext.fillRect(0, height - 76, width, 76);

        rainContext.lineCap = 'round';
        for (const drop of drops) {
          const previousY = drop.y;
          drop.y += drop.speed * delta;
          drop.x += drop.drift * drop.speed * delta;

          if (drop.y > height - 2 && previousY <= height - 2) {
            addSplash(drop.x, 1.2 + drop.width * 1.8);
          }

          if (drop.y > height + drop.length) {
            Object.assign(drop, makeDrop(-drop.length - Math.random() * height * 0.35));
          }

          rainContext.strokeStyle = `rgba(193, 222, 247, ${drop.alpha})`;
          rainContext.lineWidth = drop.width;
          rainContext.beginPath();
          rainContext.moveTo(drop.x, drop.y);
          rainContext.lineTo(drop.x + drop.drift * drop.length, drop.y + drop.length);
          rainContext.stroke();
        }

        for (let index = splashes.length - 1; index >= 0; index -= 1) {
          const splash = splashes[index];
          splash.age += delta;
          if (splash.age >= 0.42) {
            splashes.splice(index, 1);
          } else {
            drawSplash(splash);
          }
        }

        animationFrame = requestAnimationFrame(drawRain);
      };

      const setRainActivity = () => {
        if (document.visibilityState === 'visible') {
          previousTime = performance.now();
          cancelAnimationFrame(animationFrame);
          animationFrame = requestAnimationFrame(drawRain);
        } else {
          cancelAnimationFrame(animationFrame);
        }
      };

      resizeRain();
      window.addEventListener('resize', resizeRain, { passive: true });
      document.addEventListener('visibilitychange', setRainActivity);
      setRainActivity();
    }
  }
</script>

<style>
  :global([data-theme="trianthology"] body) {
    background: #050b16;
  }

  :global([data-theme="trianthology"] .site-header) {
    border-right-color: rgb(212 227 241 / 24%);
    background:
      linear-gradient(180deg, rgb(7 14 27 / 97%), rgb(4 9 18 / 95%)),
      #050b16;
    box-shadow: 0.8rem 0 2.8rem rgb(0 0 0 / 28%);
  }

  :global([data-theme="trianthology"] .brand__portrait) {
    position: relative;
    padding: 0.2rem;
    border: 1px solid rgb(225 201 142 / 42%);
    border-radius: 50%;
  }

  :global([data-theme="trianthology"] .brand__avatar) {
    border-color: rgb(237 229 232 / 65%);
    outline-color: rgb(180 31 53 / 16%);
  }

  :global([data-theme="trianthology"] .site-nav a[aria-current]) {
    background: linear-gradient(90deg, rgb(180 31 53 / 24%), transparent);
  }

  :global([data-theme="trianthology"] .site-nav a[aria-current]::after) {
    background: #e1c98e;
    box-shadow: 0 0 0.7rem rgb(225 201 142 / 55%);
  }

  :global([data-theme="trianthology"] .site-footer) {
    position: relative;
    z-index: 2;
    border-color: rgb(184 206 229 / 18%);
    background: #050b16;
  }

  .trian-page {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: clip;
    color: #f0edf0;
  }

  .cityscape {
    position: fixed;
    inset: 0 0 0 var(--sidebar);
    z-index: -3;
    overflow: hidden;
    background: #030812;
    pointer-events: none;
  }

  .cityscape::before,
  .cityscape::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
  }

  .cityscape::before {
    background:
      linear-gradient(90deg, rgb(2 7 15 / 12%) 0%, rgb(2 7 15 / 18%) 42%, rgb(2 7 15 / 78%) 74%, rgb(2 7 15 / 94%) 100%),
      linear-gradient(180deg, rgb(1 6 14 / 8%) 38%, rgb(3 9 18 / 76%) 85%, #050b16 100%);
  }

  .cityscape::after {
    opacity: 0.26;
    background-image:
      radial-gradient(circle at 9% 18%, #d9f0ff 0 1px, transparent 1.5px),
      radial-gradient(circle at 28% 9%, #fff4d2 0 1px, transparent 1.5px),
      radial-gradient(circle at 51% 16%, #d9f0ff 0 1px, transparent 1.5px),
      radial-gradient(circle at 71% 7%, #fff4d2 0 1px, transparent 1.5px),
      radial-gradient(circle at 88% 23%, #d9f0ff 0 1px, transparent 1.5px);
    background-size: 31rem 19rem;
    animation: star-breathe 8s ease-in-out infinite alternate;
  }

  .cityscape-art {
    width: 100%;
    height: 100%;
    background-position: 50% center;
    background-size: cover;
    scale: 1.035;
    animation: city-drift 26s ease-in-out infinite alternate;
    will-change: transform;
  }

  .rain {
    position: fixed;
    inset: 0 0 0 var(--sidebar);
    z-index: -2;
    width: calc(100% - var(--sidebar));
    height: 100%;
    pointer-events: none;
    opacity: 0.82;
  }

  .moon {
    position: fixed;
    top: clamp(2rem, 8vh, 6rem);
    right: clamp(3rem, 9vw, 9rem);
    z-index: -2;
    width: clamp(4rem, 8vw, 7rem);
    aspect-ratio: 1;
    border: 1px solid rgb(219 237 255 / 24%);
    border-radius: 50%;
    opacity: 0.5;
    background:
      radial-gradient(circle at 38% 34%, rgb(235 244 255 / 78%), rgb(118 160 204 / 42%) 42%, rgb(57 95 143 / 15%) 70%, transparent 72%);
    box-shadow: 0 0 3.5rem rgb(93 151 215 / 18%);
    pointer-events: none;
  }

  .shards {
    position: fixed;
    inset: 0 0 0 var(--sidebar);
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .shards span {
    position: absolute;
    width: 0.55rem;
    height: 1.2rem;
    border: 1px solid rgb(224 237 249 / 34%);
    opacity: 0.25;
    background: linear-gradient(145deg, rgb(218 238 255 / 28%), transparent 70%);
    clip-path: polygon(50% 0, 100% 34%, 62% 100%, 0 72%);
    animation: shard-drift 15s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .shards span:nth-child(1) { top: 11%; left: 46%; animation-delay: -3s; }
  .shards span:nth-child(2) { top: 27%; left: 82%; scale: 0.7; animation-delay: -7s; }
  .shards span:nth-child(3) { top: 44%; left: 58%; scale: 1.3; animation-delay: -12s; }
  .shards span:nth-child(4) { top: 68%; left: 91%; scale: 0.8; animation-delay: -5s; }
  .shards span:nth-child(5) { top: 77%; left: 39%; scale: 0.65; animation-delay: -9s; }
  .shards span:nth-child(6) { top: 88%; left: 73%; scale: 1.1; animation-delay: -1s; }

  .landing {
    position: relative;
    display: grid;
    min-height: min(48rem, calc(100svh - 1rem));
    grid-template-columns: minmax(18rem, 1fr) minmax(25rem, 0.88fr);
    align-items: center;
    width: min(calc(100% - 3rem), 1320px);
    margin-inline: auto;
    padding-block: clamp(2rem, 6vh, 5rem);
  }

  .hero-copy {
    grid-column: 2;
    width: min(100%, 37rem);
    margin-left: auto;
    padding: clamp(1.4rem, 3vw, 2.4rem);
    border: 1px solid rgb(220 231 242 / 36%);
    outline: 1px solid rgb(220 231 242 / 12%);
    outline-offset: 0.35rem;
    background:
      linear-gradient(145deg, rgb(9 18 32 / 87%), rgb(3 9 19 / 75%)),
      rgb(6 13 25 / 80%);
    box-shadow:
      0 2rem 5rem rgb(0 0 0 / 32%),
      inset 0 0 3rem rgb(108 151 197 / 5%);
    backdrop-filter: blur(9px);
  }

  .kicker {
    margin: 0 0 0.65rem;
    color: #e1c98e;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--serif);
    font-size: clamp(3.1rem, 5.5vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.85;
    white-space: nowrap;
    text-shadow: 0 0.15rem 1.5rem rgb(0 0 0 / 55%);
  }

  .title-tri {
    color: #eee9ea;
  }

  .title-tri::first-letter,
  .title-thology::first-letter {
    color: #c72c43;
  }

  .title-thology {
    color: #eee9ea;
  }

  .subtitle {
    margin: 0.7rem 0 0;
    color: #c6d2df;
    font-family: var(--serif);
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    letter-spacing: 0.06em;
  }

  .summary {
    max-width: 48ch;
    margin: 1.25rem 0 0;
    color: #c1c9d4;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.35rem;
  }

  .primary-action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 0.95rem;
    border: 1px solid rgb(226 201 142 / 62%);
    background: rgb(180 31 53 / 22%);
    color: #f4edf0;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-action:hover {
    border-color: #e1c98e;
    background: rgb(180 31 53 / 38%);
    color: #fff;
  }

  .secondary-action {
    color: #d7ba78;
    font-size: 0.82rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .secondary-action:hover,
  .release-link:hover {
    color: #fff;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #aeb9c7;
    font-size: 0.78rem;
  }

  .availability > span {
    width: 0.48rem;
    height: 0.48rem;
    rotate: 45deg;
    background: #d7ba78;
    box-shadow: 0 0 0.8rem rgb(215 186 120 / 55%);
  }

  .story-menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1rem;
    margin-top: 1.45rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(211 226 240 / 18%);
  }

  .story-menu a {
    display: flex;
    align-items: center;
    min-height: 36px;
    gap: 0.55rem;
    color: #d8dce3;
    font-size: 0.84rem;
    text-decoration: none;
  }

  .story-menu a:hover {
    color: #fff;
  }

  .menu-suit {
    width: 1rem;
    color: #d8e2ec;
    font-size: 1rem;
    text-align: center;
  }

  .red {
    color: #e07686;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.9rem;
    color: #8fa0b4;
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fragment-section,
  .status-section,
  .project-credits {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 3rem), 1320px);
    margin-inline: auto;
  }

  .fragment-section {
    padding: clamp(2.5rem, 6vw, 5rem);
    border: 1px solid rgb(197 216 235 / 20%);
    background:
      linear-gradient(135deg, rgb(12 24 42 / 96%), rgb(5 12 23 / 97%)),
      #07101d;
    box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 35%);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(18rem, 1.1fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-head > div {
    position: relative;
  }

  .section-mark {
    position: absolute;
    top: -2rem;
    left: -1rem;
    color: rgb(224 235 246 / 10%);
    font-size: 7rem;
    line-height: 1;
  }

  .section-head h2,
  .status-copy h2 {
    font-size: clamp(2rem, 3.8vw, 3.5rem);
    letter-spacing: -0.035em;
  }

  .section-head > p {
    max-width: 47ch;
    margin: 0 0 0.25rem auto;
    color: #aeb9c7;
  }

  .fragment-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgb(205 221 237 / 24%);
    border-left: 1px solid rgb(205 221 237 / 24%);
  }

  .fragment {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 10rem;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 0.8rem;
    padding: 1.35rem;
    border-right: 1px solid rgb(205 221 237 / 24%);
    border-bottom: 1px solid rgb(205 221 237 / 24%);
    scroll-margin-top: 1rem;
    background: rgb(255 255 255 / 1.5%);
  }

  .fragment-suit {
    color: #dce7f2;
    font-size: 1.7rem;
    line-height: 1;
  }

  .fragment-author {
    margin: 0 0 0.2rem;
    color: #9aaabd;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fragment h3 {
    font-size: clamp(1.35rem, 2.3vw, 2rem);
  }

  .fragment p:last-child {
    max-width: 42ch;
    margin: 0.65rem 0 0;
    color: #b9c3cf;
    font-size: 0.9rem;
  }

  .fragment-number {
    color: rgb(211 225 239 / 24%);
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .status-section {
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(22rem, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3.5rem);
